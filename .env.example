# Database
DATABASE_URL=postgresql://badgerbase:badgerbase_dev@localhost:5432/badgerbase

# Redis (required for api.js caching)
REDIS_URL=redis://localhost:6379

# API auth
GET_API_KEY=your-query-api-key
SUBSCRIPTION_API_KEY=your-subscription-api-key

# Email (optional — subscriptions work without it, just won't send confirmations)
ELASTICEMAIL_API_KEY=your-elasticemail-key
FROM_EMAIL=noreply@badgerbase.app

# Server
PORT=3000

# better-auth (identity provider — replaces Supabase)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Must be set explicitly. There is no fallback to DATABASE_URL (which
# points at production) — auth.ts throws at import time if this is unset.
AUTH_DATABASE_URL=
