# Database
MYSQL_URL=mysql://user:password@localhost:3306/badgerbase

# Redis (required for api.js caching)
REDIS_URL=redis://localhost:6379

# API auth
GET_API_KEY=your-query-api-key
SUBSCRIPTION_API_KEY=your-subscription-api-key

# Supabase (subscription API JWT verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email (optional — subscriptions work without it, just won't send confirmations)
ELASTICEMAIL_API_KEY=your-elasticemail-key
FROM_EMAIL=noreply@badgerbase.app

# Server
PORT=3000
