# Database
DATABASE_URL=postgresql://badgerbase:badgerbase_dev@localhost:5432/badgerbase

# Redis (required for api.js caching)
REDIS_URL=redis://localhost:6379

# API auth
GET_API_KEY=your-query-api-key
SUBSCRIPTION_API_KEY=your-subscription-api-key


# Server
PORT=3000

# better-auth (identity provider — replaces Supabase)
BETTER_AUTH_SECRET=
# Public origin of the frontend, e.g. https://badgerbase.app. Emailed auth
# links (magic link, email confirmation) are rewritten to this origin so the
# click lands on the frontend's same-origin /api/auth proxy — /magic-link/verify
# sets the session cookie on whichever host serves it, and this API is on a
# different registrable domain in production. Leave unset for local dev, where
# the API and frontend are same-site and the links work as-is.
APP_URL=
# points at production) — auth.ts throws at import time if this is unset.

# Email (self-hosted SMTP). Port 2525, not 465: Railway blocks outbound
# connections to the standard submission ports, so 465 times out from the
# API. Mox serves implicit TLS on 2525 exactly as it did on 465. Required for magic-link sign-in and email
# verification — without SMTP_HOST, sign-up succeeds but no user can ever
# confirm their address, so treat these as required in production.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local Postgres for the test suite. Required to run `bun test`: auth.ts
# resolves this instead of DATABASE_URL when NODE_ENV=test, which is what
# keeps the suite from signing users up against production.
TEST_DATABASE_URL=

# Public base URL of this API, including the scheme. better-auth builds
# emailed links and validates origins against it, and server.ts derives the
# JWKS URL from it. Must NOT be a Railway *.railway.internal hostname: those
# resolve only inside Railway's private network, so the frontend on Vercel
# cannot reach one. Startup fails with a clear message if either rule is
# broken.
BETTER_AUTH_URL=
